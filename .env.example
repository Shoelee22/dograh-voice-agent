# Dograh instance (self-hosted via the official installer)
DOGRAH_API_URL=http://localhost:3010/api/v1
DOGRAH_API_KEY=dg_your_api_key_here

# Public URL of the tools server, as reachable FROM the Dograh containers.
# Docker Desktop (Mac/Windows): http://host.docker.internal:8090
# Linux: host LAN IP or docker0 gateway, e.g. http://172.17.0.1:8090
TOOLS_PUBLIC_URL=http://host.docker.internal:8090

# Outbound test call
AGENT_UUID=
TEST_PHONE=+91XXXXXXXXXX
